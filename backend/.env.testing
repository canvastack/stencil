APP_NAME=CanvaStencil
APP_ENV=testing
APP_KEY=base64:TEST_KEY_FOR_TESTING_PURPOSES_ONLY
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Test Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stencil_canvastack_test
DB_USERNAME=postgres
DB_PASSWORD=@admin

# Cache & Session Configuration for Testing
BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

# Mail Configuration for Testing
MAIL_MAILER=array
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum Configuration for Testing
SANCTUM_STATEFUL_DOMAINS=localhost

# Disable Features for Testing
PULSE_ENABLED=false
TELESCOPE_ENABLED=false

# Currency Configuration
DEFAULT_EXCHANGE_RATE=15750
DEFAULT_CURRENCY=IDR
SECONDARY_CURRENCY=USD

# Bcrypt Rounds (lower for faster tests)
BCRYPT_ROUNDS=4
