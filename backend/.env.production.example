# ========================================
# Customer Quote & Approval Workflow
# Production Environment Configuration
# ========================================

# Application
APP_NAME="CanvaStencil"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database
DB_CONNECTION=pgsql
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_DATABASE=stencil_production
DB_USERNAME=stencil_user
DB_PASSWORD=your_secure_database_password_here

# Redis
REDIS_HOST=your-redis-host.com
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Alternative: AWS SES
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=your_ses_access_key
# AWS_SECRET_ACCESS_KEY=your_ses_secret_key
# AWS_DEFAULT_REGION=ap-southeast-1

# File Storage (AWS S3)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_s3_access_key_here
AWS_SECRET_ACCESS_KEY=your_s3_secret_key_here
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=your-production-bucket-name
AWS_URL=https://your-production-bucket-name.s3.ap-southeast-1.amazonaws.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Alternative: DigitalOcean Spaces
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_spaces_key
# AWS_SECRET_ACCESS_KEY=your_spaces_secret
# AWS_DEFAULT_REGION=sgp1
# AWS_BUCKET=your-space-name
# AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
# AWS_URL=https://your-space-name.sgp1.digitaloceanspaces.com

# Customer Quote Settings
CUSTOMER_QUOTE_DEFAULT_VALIDITY_DAYS=7
CUSTOMER_QUOTE_MAX_NEGOTIATION_ROUNDS=3
CUSTOMER_QUOTE_AUTO_APPROVAL_THRESHOLD=5000000
CUSTOMER_QUOTE_EXPIRY_CHECK_ENABLED=true
CUSTOMER_QUOTE_METRICS_CHECK_ENABLED=true

# Sanctum (API Authentication)
SANCTUM_STATEFUL_DOMAINS=your-domain.com,www.your-domain.com
SESSION_DOMAIN=.your-domain.com

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Monitoring & Error Tracking
SENTRY_LARAVEL_DSN=your_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telescope (disable in production)
TELESCOPE_ENABLED=false

# Broadcasting
BROADCAST_DRIVER=redis
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_CUSTOMER_VIEW=60
RATE_LIMIT_CUSTOMER_ACTION=10
RATE_LIMIT_ADMIN=100

# Backup Configuration
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=admin@your-domain.com

# Multi-tenancy
TENANCY_DATABASE_AUTO_DELETE=false
TENANCY_DATABASE_AUTO_DELETE_USER=false

# PDF Generation
PDF_BINARY=/usr/local/bin/wkhtmltopdf
PDF_TIMEOUT=60

# Document Storage
DOCUMENT_STORAGE_PATH=documents
DOCUMENT_MAX_SIZE=10485760
DOCUMENT_ALLOWED_TYPES=pdf,jpg,jpeg,png

# Notification Channels
NOTIFICATION_CHANNELS=mail,database
NOTIFICATION_SLACK_WEBHOOK=

# Performance
OCTANE_SERVER=swoole
OCTANE_HTTPS=true

# Maintenance
MAINTENANCE_MODE_SECRET=your_secret_bypass_key

# ========================================
# Third-Party Services (Optional)
# ========================================

# Google Analytics
GOOGLE_ANALYTICS_ID=

# Stripe (Future Payment Gateway)
STRIPE_KEY=
STRIPE_SECRET=

# Midtrans (Future Payment Gateway)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# Xendit (Future Payment Gateway)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=

# SMS Gateway (Optional)
SMS_DRIVER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ========================================
# Development/Staging Overrides
# ========================================
# Uncomment for staging environment

# APP_ENV=staging
# APP_DEBUG=true
# LOG_LEVEL=debug
# TELESCOPE_ENABLED=true
# MAIL_MAILER=log
# QUEUE_CONNECTION=sync
