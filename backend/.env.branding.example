# ============================================
# COMPANY BRANDING CONFIGURATION
# ============================================
# Copy these settings to your .env file and customize them
# for your company's branding needs.

# --------------------------------------------
# Company Information
# --------------------------------------------
BRANDING_COMPANY_NAME="PT Custom Etching Xenial"
BRANDING_TAGLINE="Excellence in Custom Etching Solutions"
BRANDING_ADDRESS="Jl. Industri No. 123, Jakarta 12345, Indonesia"
BRANDING_PHONE="+62 21 1234 5678"
BRANDING_EMAIL="info@custometchingxenial.com"
BRANDING_WEBSITE="https://www.custometchingxenial.com"
BRANDING_TAX_ID="01.234.567.8-901.000"

# --------------------------------------------
# Logo Configuration
# --------------------------------------------
# Path relative to public directory
# Recommended: SVG or PNG with transparent background
# Max dimensions: 200x80 pixels
BRANDING_LOGO_PATH="images/branding/company-logo.svg"
BRANDING_LOGO_WIDTH=200
BRANDING_LOGO_HEIGHT=80

# --------------------------------------------
# Brand Colors
# --------------------------------------------
# Use hex color codes (e.g., #4F46E5)
BRANDING_PRIMARY_COLOR="#4F46E5"    # Indigo - Main brand color
BRANDING_SECONDARY_COLOR="#059669"  # Green - Success/positive actions
BRANDING_ACCENT_COLOR="#DC2626"     # Red - Alerts/important items

# --------------------------------------------
# Document Footer
# --------------------------------------------
BRANDING_FOOTER_TEXT="Quality Etching Services Since 2020"

# --------------------------------------------
# Social Media Links (Optional)
# --------------------------------------------
BRANDING_FACEBOOK="https://facebook.com/yourcompany"
BRANDING_INSTAGRAM="https://instagram.com/yourcompany"
BRANDING_LINKEDIN="https://linkedin.com/company/yourcompany"
BRANDING_TWITTER="https://twitter.com/yourcompany"

# --------------------------------------------
# Bank Details (for Payment Instructions)
# --------------------------------------------
BRANDING_BANK_NAME="Bank Central Asia (BCA)"
BRANDING_BANK_ACCOUNT_NAME="PT Custom Etching Xenial"
BRANDING_BANK_ACCOUNT_NUMBER="1234567890"
BRANDING_BANK_SWIFT_CODE="CENAIDJA"
BRANDING_BANK_BRANCH="Jakarta Pusat"

# --------------------------------------------
# Document Display Settings
# --------------------------------------------
BRANDING_SHOW_LOGO=true
BRANDING_SHOW_TAGLINE=true
BRANDING_SHOW_WEBSITE=true
BRANDING_SHOW_SOCIAL_MEDIA=false

# ============================================
# USAGE INSTRUCTIONS
# ============================================
#
# 1. Copy these settings to your main .env file
# 2. Update values with your company information
# 3. Add your company logo to: public/images/branding/
# 4. Run: php artisan config:clear
# 5. Test by generating a PDF document
#
# For more information, see:
# - backend/config/branding.php
# - backend/public/images/branding/README.md
#
# ============================================
